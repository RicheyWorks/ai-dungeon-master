# Copy to deploy/.env and fill in. Never commit real secrets.
#   cp deploy/.env.example deploy/.env
#   ./scripts/gen-secrets.sh >> deploy/.env   # optional helper
#   # then set GAME_CORS_ALLOWED_ORIGINS + DOMAIN by hand

# --- Postgres ---
POSTGRES_DB=dungeon
POSTGRES_USER=dm
POSTGRES_PASSWORD=replace-with-strong-db-password

# --- App auth ---
GAME_AUTH_ENABLED=true
GAME_AUTH_JWT_SECRET=replace-with-at-least-32-random-chars
GAME_AUTH_JWT_TTL_SECONDS=86400
GAME_AUTH_SESSION_STORE=jdbc
GAME_AUTH_ENTITLEMENT_STORE=jdbc
GAME_AUTH_JDBC_URL=jdbc:postgresql://postgres:5432/dungeon
GAME_AUTH_JDBC_USERNAME=dm
GAME_AUTH_JDBC_PASSWORD=replace-with-strong-db-password
GAME_AUTH_JDBC_DRIVER=org.postgresql.Driver
GAME_AUTH_REDIS_URL=redis://redis:6379
GAME_AUTH_REDIS_KEY_PREFIX=dm

# Production guard (also set by spring profile "prod")
GAME_PRODUCTION=true
SPRING_PROFILES_ACTIVE=prod

# --- Ops / admin (required in prod: ≥ 24 chars) ---
GAME_ADMIN_TOKEN=replace-with-strong-admin-token-24chars+

# --- CORS (required in prod: explicit origins, no wildcards) ---
# Same-origin SPA at https://DOMAIN/app/ still needs an allow-list for the guard.
GAME_CORS_ALLOWED_ORIGINS=https://dm.example.com

# --- Multi-node stores (prod profile defaults to redis for these) ---
GAME_RATE_LIMIT_STORE=redis
GAME_RATE_LIMIT_TRUST_FORWARDED_HEADERS=true
GAME_AUTH_RECEIPT_LEDGER_STORE=redis
GAME_CONTENT_SESSION_PACKS_STORE=redis
GAME_MARKETPLACE_JOBS_STORE=redis
GAME_CONTENT_PACKS_DIR=/data/packs
GAME_SAVES_DIR=/data/saves
GAME_LEGACY_API_ENABLED=false

# --- Storefronts (pick sandbox secrets OR live credentials) ---
STOREFRONT_DEV_SECRET=replace-dev-hmac-secret
STOREFRONT_GOOGLE_SECRET=replace-google-sandbox-hmac
STOREFRONT_APPLE_SECRET=replace-apple-sandbox-hmac
STOREFRONT_STEAM_SECRET=replace-steam-sandbox-hmac

# Live (optional — if set, sandbox secret rotation is not required)
# STOREFRONT_GOOGLE_PACKAGE_NAME=com.example.dm
# STOREFRONT_GOOGLE_ACCESS_TOKEN=
# STOREFRONT_APPLE_SHARED_SECRET=
# STOREFRONT_APPLE_BUNDLE_ID=com.example.dm
# STOREFRONT_STEAM_PUBLISHER_KEY=
# STOREFRONT_STEAM_APP_ID=
# STOREFRONT_STEAM_SANDBOX=false

# --- TLS (prod compose) ---
TLS_CERT=/etc/nginx/certs/fullchain.pem
TLS_KEY=/etc/nginx/certs/privkey.pem
DOMAIN=dm.example.com

# --- Grafana (metrics overlay) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ROOT_URL=http://localhost:3000

# --- Alertmanager receivers (optional) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_CHANNEL=#dm-alerts
# PAGERDUTY_ROUTING_KEY=
# ALERTMANAGER_CONFIG=alertmanager.active.yml

# Metrics scrape token (required in prod by ProductionSecurityGuard)
GAME_METRICS_SCRAPE_TOKEN=replace-with-metrics-scrape-token
# Plugins
GAME_PLUGINS_SIGNATURE_POLICY=REQUIRED

# Optional previous admin token during rotation
# GAME_ADMIN_TOKEN_PREVIOUS=
